---
# All checks, except those that conflict with deliberate choices of this code
# base, with ROOT or with the performance of the simulation:
#
# altera-*, fuchsia-*, llvmlibc-*: rules of other projects
# fuchsia-multiple-inheritance, misc-multiple-inheritance: the persistent
#   classes derive from TObject and FastCaloSim::MLogging
# google-readability-todo: TODOs without an author are fine
# llvm-header-guard, portability-avoid-pragma-once: we use #pragma once
# llvm-include-order: the order is set by clang-format
# llvm-prefer-static-over-anonymous-namespace: anonymous namespaces are fine
# modernize-use-nodiscard: too aggressive, the attribute is situationally
#   useful
# misc-non-private-member-variables-in-classes,
# cppcoreguidelines-non-private-member-variables-in-classes: the
#   parametrization classes give their derived classes access to their
#   (persistent) members
# readability-identifier-naming, readability-identifier-length: the names
#   follow the existing (TFCS, m_) conventions that Athena uses
# readability-magic-numbers, cppcoreguidelines-avoid-magic-numbers: physics
#   and detector constants
# readability-math-missing-parentheses: operator precedence is not unclear
# readability-function-cognitive-complexity: the simulation steps are long
#   by nature; splitting them is a refactoring of its own
# cppcoreguidelines-avoid-do-while, cppcoreguidelines-macro-usage: the
#   logging macros and ROOT's ClassDef
# cppcoreguidelines-owning-memory: ROOT's ownership model with raw pointers
#   (parametrization chains, histograms read from files)
# cppcoreguidelines-pro-type-static-cast-downcast: downcasts after an
#   InheritsFrom() or IsA() check, as ROOT does it
# cppcoreguidelines-pro-type-reinterpret-cast: byte level I/O (cell store,
#   libxml2 strings)
# cppcoreguidelines-pro-type-vararg: printf style output of the benchmark
# cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
# cppcoreguidelines-pro-bounds-constant-array-index,
# cppcoreguidelines-pro-bounds-pointer-arithmetic,
# cppcoreguidelines-pro-bounds-array-to-pointer-decay: bounds checked access
#   (at()) in the per-hit code would slow down the simulation; ROOT arrays
#   are accessed through pointers
# cppcoreguidelines-use-enum-class, performance-enum-size: would change
#   public (FCSReturnCode, Cell::SubPos) and persistent enums
# bugprone-easily-swappable-parameters: (eta, phi, r, z, E) interfaces
# google-runtime-int: ROOT and the standard library use long
# google-default-arguments: default arguments of virtual functions are part
#   of the public interface
# misc-include-cleaner: ROOT and Geant4 headers are not include-what-you-use
#   clean
# misc-no-recursion: the parametrization chains are trees
# concurrency-mt-unsafe: the flagged functions are only called during
#   initialization
# android-cloexec-*: no fork/exec
# cert-err58-cpp, bugprone-throwing-static-initialization: static tables
#   whose construction cannot fail in practice
# boost-use-ranges, llvm-use-ranges: duplicates of modernize-use-ranges
Checks: "*,\
  -altera-*,\
  -fuchsia-*,\
  -llvmlibc-*,\
  -misc-multiple-inheritance,\
  -google-readability-todo,\
  -llvm-header-guard,\
  -portability-avoid-pragma-once,\
  -llvm-include-order,\
  -llvm-prefer-static-over-anonymous-namespace,\
  -modernize-use-nodiscard,\
  -misc-non-private-member-variables-in-classes,\
  -cppcoreguidelines-non-private-member-variables-in-classes,\
  -readability-identifier-naming,\
  -readability-identifier-length,\
  -readability-magic-numbers,\
  -cppcoreguidelines-avoid-magic-numbers,\
  -readability-math-missing-parentheses,\
  -readability-function-cognitive-complexity,\
  -cppcoreguidelines-avoid-do-while,\
  -cppcoreguidelines-macro-usage,\
  -cppcoreguidelines-owning-memory,\
  -cppcoreguidelines-pro-type-static-cast-downcast,\
  -cppcoreguidelines-pro-type-reinterpret-cast,\
  -cppcoreguidelines-pro-type-vararg,\
  -hicpp-vararg,\
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,\
  -cppcoreguidelines-pro-bounds-constant-array-index,\
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,\
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,\
  -hicpp-no-array-decay,\
  -cppcoreguidelines-use-enum-class,\
  -performance-enum-size,\
  -bugprone-easily-swappable-parameters,\
  -google-runtime-int,\
  -google-default-arguments,\
  -misc-include-cleaner,\
  -misc-no-recursion,\
  -concurrency-mt-unsafe,\
  -android-cloexec-*,\
  -cert-err58-cpp,\
  -bugprone-throwing-static-initialization,\
  -boost-use-ranges,\
  -llvm-use-ranges"
WarningsAsErrors: ''
CheckOptions:
  - key: 'bugprone-argument-comment.StrictMode'
    value: 'true'
# Prefer using enum classes with 2 values for parameters instead of bools
  - key: 'bugprone-argument-comment.CommentBoolLiterals'
    value: 'true'
  - key: 'bugprone-misplaced-widening-cast.CheckImplicitCasts'
    value: 'true'
  - key: 'bugprone-sizeof-expression.WarnOnSizeOfIntegerExpression'
    value: 'true'
  - key: 'bugprone-suspicious-string-compare.WarnOnLogicalNotComparison'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalReturn'
    value: 'true'
  - key: 'readability-simplify-boolean-expr.ChainedConditionalAssignment'
    value: 'true'
  - key: 'readability-uniqueptr-delete-release.PreferResetCall'
    value: 'true'
  - key: 'cppcoreguidelines-init-variables.MathHeader'
    value: '<cmath>'
  - key: 'cppcoreguidelines-narrowing-conversions.PedanticMode'
    value: 'true'
  - key: 'readability-else-after-return.WarnOnUnfixable'
    value: 'true'
  - key: 'readability-else-after-return.WarnOnConditionVariables'
    value: 'true'
  - key: 'readability-inconsistent-declaration-parameter-name.Strict'
    value: 'true'
  - key: 'readability-qualified-auto.AddConstToQualified'
    value: 'true'
  - key: 'readability-redundant-access-specifiers.CheckFirstDeclaration'
    value: 'true'
...
