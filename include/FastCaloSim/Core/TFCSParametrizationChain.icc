#include <algorithm>

#include "FastCaloSim/Core/TFCSParametrization.h"

inline auto TFCSParametrizationChain::first_warned_retry(int max_retries) -> int
{
  return std::max(max_retries / 2, 1);
}

inline auto TFCSParametrizationChain::simulate_and_retry(
    TFCSParametrizationBase* parametrization,
    TFCSSimulationState& simulstate,
    const TFCSTruthState* truth,
    const TFCSExtrapolationState* extrapol) const -> FCSReturnCode
{
  int max_retries = 0;
  for (int attempt = 0; attempt <= max_retries; ++attempt) {
    if (attempt >= first_warned_retry(max_retries)) {
      FCS_MSG_WARNING(
          "TFCSParametrizationChain::simulate_and_retry(): Retry simulate call "
          << attempt << "/" << max_retries);
}

    const FCSReturnCode status =
        parametrization->simulate(simulstate, truth, extrapol);
    if (status == FCSSuccess || status == FCSFatal) {
      return status;
}

    max_retries = status.max_retries();
    if (RetryChainFromStart()) {
      return status;
}
  }

  FCS_MSG_FATAL(
      "TFCSParametrizationChain::simulate_and_retry(): Simulate call "
      "failed after "
      << max_retries << " retries");
  return FCSFatal;
}

template<typename Pass>
auto TFCSParametrizationChain::simulate_with_restarts(const char* name,
                                                      Pass pass) const
    -> FCSReturnCode
{
  int max_retries = 0;
  for (int attempt = 0; attempt <= max_retries; ++attempt) {
    if (attempt >= first_warned_retry(max_retries)) {
      FCS_MSG_WARNING(name << ": Retry simulate call " << attempt << "/"
                           << max_retries);
}

    const FCSReturnCode status = pass();
    if (status == FCSSuccess || status == FCSFatal) {
      return status;
}

    max_retries = status.max_retries();
  }

  FCS_MSG_FATAL(name << ": Simulate call failed after " << max_retries
                     << " retries");
  return FCSFatal;
}
